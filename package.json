{
  "name": "leadprophet-e2e",
  "private": true,
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:all-browsers": "playwright test --project=chromium --project=firefox-smoke --project=webkit-smoke",
    "test:e2e:flaky": "playwright test --project=chromium --repeat-each=5",
    "test:e2e:production": "playwright test --config=playwright.production.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.63.0"
  }
}
